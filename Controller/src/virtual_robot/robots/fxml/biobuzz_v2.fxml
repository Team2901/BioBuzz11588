<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.Group?>
<?import javafx.scene.shape.Circle?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.shape.Line?>

<!-- biobuzz_v2: biobuzz_v1 with the launcher flywheel on a turret. The turret group (plate,
     flywheel and a barrel showing which way it shoots) rotates about the flywheel's center.
     The front of the robot is the top edge (the LIME marker). -->
<Group xmlns="http://javafx.com/javafx/8.0.172-ea" xmlns:fx="http://javafx.com/fxml/1" fx:controller="virtual_robot.robots.classes.BioBuzzV2">
    <children>
        <!-- chassis -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="GOLD" height="75.0" stroke="BLACK" strokeType="INSIDE" width="75.0" />

        <!-- wheels -->
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" y="55.0" />
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" />
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" x="65.0" />
        <Rectangle arcHeight="5.0" arcWidth="5.0" fill="BLUE" height="20.0" stroke="BLACK" strokeType="INSIDE" width="10.0" x="65.0" y="55.0" />

        <!-- intake roller, across the front between the front wheels -->
        <Rectangle fx:id="intakeRoller" arcHeight="5.0" arcWidth="5.0" fill="DARKGRAY" height="7.0" stroke="BLACK" strokeType="INSIDE" width="45.0" x="15.0" y="12.0" />
        <!-- transfer belt, from the intake back to the launcher -->
        <Rectangle fx:id="transferBelt" arcHeight="3.0" arcWidth="3.0" fill="DARKGRAY" height="20.0" stroke="BLACK" strokeType="INSIDE" width="9.0" x="33.0" y="20.0" />

        <!-- X coordinate (forward = positive power = X direction) -->
        <Line startX="37.5" endX="37.5"  startY="0" endY="37.5" stroke="LIME" strokeWidth="1.0"/>
        <Line startX="37.5" endX="42.5"  startY="0" endY="4.0" stroke="BLACK" strokeWidth="1.0"/>
        <Line startX="37.5" endX="32.5"  startY="0" endY="4.0" stroke="BLACK" strokeWidth="1.0"/>

        <!-- Letter x -->
        <Line startX="44" endX="48"  startY="5" endY="9" stroke="BLACK" strokeWidth="1.0"/>
        <Line startX="44" endX="48"  startY="9" endY="5" stroke="BLACK" strokeWidth="1.0"/>

        <!-- Y coordinate (strafe left = positive power = Y direction) -->
        <Line startX="37.5" endX="0"  startY="37.5" endY="37.5" stroke="LIME" strokeWidth="1.0"/>
        <Line startX="5"  startY="32.5" endX="0"  endY="37.5" stroke="BLACK" strokeWidth="1.0"/>
        <Line startX="5"  startY="42.0" endX="0"  endY="37.5" stroke="BLACK" strokeWidth="1.0"/>

        <!-- Letter y -->
        <Line startX="10" endX="12"  startY="40" endY="42" stroke="BLACK" strokeWidth="1.0"/>
        <Line startX="10" endX="12"  startY="44" endY="42" stroke="BLACK" strokeWidth="1.0"/>
        <Line startX="12" endX="14"  startY="42" endY="42" stroke="BLACK" strokeWidth="1.0"/>

        <!-- turret, toward the back; drawn last so it sits on top as it turns -->
        <Group fx:id="turret">
            <children>
                <Circle centerX="37.5" centerY="53.0" fill="SLATEGRAY" radius="14.0" stroke="BLACK" strokeType="INSIDE" />
                <!-- barrel: the direction the launcher shoots, forward when the turret is at 0 -->
                <Rectangle arcHeight="3.0" arcWidth="3.0" fill="ORANGE" height="16.0" stroke="BLACK" strokeType="INSIDE" width="8.0" x="33.5" y="31.0" />
                <Circle fx:id="launcherWheel" centerX="37.5" centerY="53.0" fill="DIMGRAY" radius="11.0" stroke="BLACK" strokeType="INSIDE" strokeWidth="1.5" />
                <Circle centerX="37.5" centerY="53.0" fill="BLACK" radius="2.5" />
            </children>
        </Group>

    </children>
</Group>
